<resources>
    <string name="demo_app_name">PM Guide Demos</string>
    <string name="demo_home_title">Demo 集合</string>
    <string name="demo_home_subtitle">独立 demo module，不影响主 app</string>
    <string name="demo_home_kicker">SAMPLES</string>
    <string name="demo_home_heading">选择要运行的 Demo</string>
    <string name="demo_home_body">每个示例各自独立，代码和资源都只属于 demo module，可以单独安装运行。</string>
    <string name="demo_home_nested_title">嵌套滚动 + 覆盖底栏</string>
    <string name="demo_home_nested_body">NestedScrollView、两个动态子布局、RecyclerView 与底栏遮挡。</string>
    <string name="demo_home_video_title">视频首帧</string>
    <string name="demo_home_video_body">MediaMetadataRetriever 与 Glide 两种方式加载视频首帧。</string>
    <string name="demo_home_slot_title">Slot 布局 + 覆盖底栏</string>
    <string name="demo_home_slot_body">复现 slot 显隐时的底栏遮挡与列表侵入，并给出统一外层滚动的写法。</string>

    <!-- NestedScrollView + 底栏遮挡 Demo -->
    <string name="nested_demo_title">嵌套滚动 Demo</string>
    <string name="nested_demo_subtitle">内容可滑入底栏下方，末尾不被遮挡</string>
    <string name="nested_demo_tab_a">布局 A · 纵向内容</string>
    <string name="nested_demo_tab_b">布局 B · 列表</string>

    <string name="nested_demo_a_kicker">子布局 A</string>
    <string name="nested_demo_a_title">纯纵向内容</string>
    <string name="nested_demo_a_subtitle">普通的纵向 LinearLayout，内部可以有任意多个子 View。</string>
    <string name="nested_demo_a_hero_title">内容可以滑到底栏下面</string>
    <string name="nested_demo_a_hero_body">底栏是覆盖在滚动区域上的独立 View。NestedScrollView 开启 clipToPadding=false，内容不会被底栏上沿裁掉，而是继续画到底栏背后。</string>
    <string name="nested_demo_a_card1_title">子布局 A · 纵向容器</string>
    <string name="nested_demo_a_card1_body">普通 View 依次排布，没有自己的滚动。内容再长，也由外层 NestedScrollView 统一滚动。</string>
    <string name="nested_demo_a_card2_title">滚动范围包含底栏区域</string>
    <string name="nested_demo_a_card2_body">底栏是半透明的，滚动时能直接看到卡片从底栏后面透出来，而不是在底栏上沿被切掉。</string>
    <string name="nested_demo_a_card3_title">paddingBottom 负责末尾留白</string>
    <string name="nested_demo_a_card3_body">底部 padding 不裁剪内容，但会被算进滚动范围，因此最后的内容能停到底栏上方。</string>
    <string name="nested_demo_a_card4_title">底栏高度是运行时算的</string>
    <string name="nested_demo_a_card4_body">在 onLayoutChange 里读取底栏实际高度，再设置 paddingBottom，适配不同文案和字号。</string>
    <string name="nested_demo_a_card5_title">两个子布局轮流显示</string>
    <string name="nested_demo_a_card5_body">两个子布局都已 inflate，只把当前选中的设为 VISIBLE，另一个 GONE，所以隐藏内容不占高度。</string>
    <string name="nested_demo_a_end">滚动到底：这段文字完整停在底栏上方。</string>

    <string name="nested_demo_b_kicker">子布局 B</string>
    <string name="nested_demo_b_title">头部内容 + RecyclerView</string>
    <string name="nested_demo_b_body">上面先放一段头部内容，下面的列表容器占满剩余高度。切换列表项数量，观察列表少时容器仍然撑满，多时整体一起滚动。</string>
    <string name="nested_demo_count_none">0 项</string>
    <string name="nested_demo_count_three">3 项</string>
    <string name="nested_demo_count_long">20 项</string>
    <string name="nested_demo_list_title">RecyclerView</string>
    <string name="nested_demo_list_count">共 %1$d 项</string>
    <string name="nested_demo_list_empty">当前 0 项。列表容器仍占满剩余高度，底部 padding 保证它不会伸进底栏被裁掉。</string>
    <string name="nested_demo_item_title">列表项 %1$d</string>
    <string name="nested_demo_item_subtitle">跟随外层 NestedScrollView 一起滚动</string>

