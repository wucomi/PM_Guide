    <!-- Slot + 底栏 Demo -->
    <string name="slot_demo_title">Slot 布局 + 底栏</string>
    <string name="slot_demo_subtitle">复现并修复首页 slot 的遮挡问题</string>
    <string name="slot_demo_kicker">HOME SLOTS</string>
    <string name="slot_demo_heading">动态 Slot 首页</string>
    <string name="slot_demo_intro">slot1-4 是普通的 wrap_content 内容，slot5 是设备列表。切换底栏场景：隐藏 slot5 时看 slot4 滚到底是否被遮挡；隐藏 slot1-3 时看设备列表能否侵入底栏。</string>
    <string name="slot_demo_slot1_title">Slot 1 · 常用设备</string>
    <string name="slot_demo_slot1_body">普通内容，不参与内部滚动。这里用固定的多行文案撑出高度，模拟首页里多个可插拔能力插槽叠在一起的效果。</string>
    <string name="slot_demo_slot2_title">Slot 2 · 快捷入口</string>
    <string name="slot_demo_slot2_body">slot 可以是任意动态内容。重点是保持 wrap_content，让它们的高度由内容决定，而不是被外层滚动容器强行撑满或裁剪。</string>
    <string name="slot_demo_slot3_title">Slot 3 · 消息提醒</string>
    <string name="slot_demo_slot3_body">如果某个 slot 自己再套一层 RecyclerView 或 SmartRefreshLayout，要把内部滚动关掉，否则手势会被内层吃掉，外层就滚不动了。</string>
    <string name="slot_demo_slot4_title">Slot 4 · 服务与设置</string>
    <string name="slot_demo_slot4_body">它是 slot5 上方的最后一块内容。隐藏 slot5 后滚到底，这段文字必须完整停在底栏上方，说明底部 padding 预留正确。</string>
    <string name="slot_demo_slot5_title">Slot 5 · 设备列表</string>
    <string name="slot_demo_count_format">共 %1$d 台</string>
    <string name="slot_demo_empty">当前 0 台设备。slot5 仍然占满剩余高度，末尾不会被底栏遮挡。</string>
    <string name="slot_demo_device_title">设备 %1$d</string>
    <string name="slot_demo_device_subtitle">模拟设备列表项，跟随外层统一滚动</string>
